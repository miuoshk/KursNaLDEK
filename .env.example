# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STOMATOLOGIA_1=price_...
# STRIPE_PRICE_STOMATOLOGIA_3=price_...
# STRIPE_PRICE_LEKARSKI_1=price_...
# LDEW — jednorazowe SKU (30 / 180 / 365 dni). Te same klucze dopisz w Vercel → Settings → Environment Variables (Production + Preview).
STRIPE_PRICE_LDEW_30=price_1U9VLJPnh9LxeztiETH0gDyq
STRIPE_PRICE_LDEW_180=price_1U9VQrPnh9Lxeztihh8lNWI8
STRIPE_PRICE_LDEW_365=price_1U9VZ7Pnh9Lxezti2dAyfL5v
# LDEK kliniczny (ten sam model, gdy sprzedaż ruszy)
# STRIPE_PRICE_LDEK_30=price_...
# STRIPE_PRICE_LDEK_180=price_...
# STRIPE_PRICE_LDEK_365=price_...

# Flaga UI źródeł referencyjnych (CEM / „z egzaminów”).
# Zmienne NEXT_PUBLIC_* są wstrzykiwane przy buildzie, nie czytane w runtime.
# Zmiana flagi wymaga redeployu na Vercelu. To nie jest kill switch.
NEXT_PUBLIC_FEATURE_CEM_SOURCE=false
